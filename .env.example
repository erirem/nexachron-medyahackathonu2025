# ===========================================
# Nexachron Docker Environment Variables
# ===========================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# ===========================================
# Supabase Configuration
# ===========================================
# Supabase proje URL'inizi buraya yazın
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon key (public key)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key (private key - sadece API için)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===========================================
# OpenAI Configuration
# ===========================================
# OpenAI API anahtarınızı buraya yazın
OPENAI_API_KEY=your-openai-api-key

# OpenAI API URL (varsayılan: https://api.openai.com/v1)
OPENAI_API_URL=https://api.openai.com/v1

# ===========================================
# Application Ports
# ===========================================
# API portu (varsayılan: 4000)
API_PORT=4000

# Web portu (varsayılan: 3000)
WEB_PORT=3000

# Mobile portu (varsayılan: 8080)
MOBILE_PORT=8080

# ===========================================
# Frontend URLs (Docker için)
# ===========================================
# Frontend URL'i (API CORS için)
FRONTEND_URL=http://localhost:3000

# API URL'i (Web uygulaması için)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ===========================================
# Development Settings
# ===========================================
# Node environment
NODE_ENV=development

# Log level
LOG_LEVEL=debug

# ===========================================
# Notlar
# ===========================================
# 1. Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# 2. apps/api/.env dosyası oluşturun (API için aynı değerler)
# 3. apps/web/.env.local dosyası oluşturun (Web için NEXT_PUBLIC_* değişkenleri)
# 4. apps/mobile/lib/core/config.dart dosyasını güncelleyin (Mobile için)
